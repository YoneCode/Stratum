# =============================================================================
# Stratum environment template — copy to .env and fill in real values.
# Never commit .env. Never paste real secrets in chat.
# =============================================================================

# --- Arc Testnet ------------------------------------------------------------
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.network"
ARC_TESTNET_CHAIN_ID="5042002"
ARC_TESTNET_EXPLORER="https://testnet.arcscan.app"

# --- Deployer (Foundry) -----------------------------------------------------
# Prefer `cast wallet import` over plaintext keys. Foundry will read the named
# keystore via `--account <name>` instead of --private-key.
DEPLOYER_ADDRESS=""
# Optional: only set if absolutely necessary; prefer keystore.
DEPLOYER_PRIVATE_KEY=""

# --- Circle (Developer-Controlled Wallets + SCP) ----------------------------
# Get from console.circle.com. Use the TEST_API_KEY: prefix on testnet.
CIRCLE_API_KEY=""
# Registered entity secret (raw hex). Register via console once.
CIRCLE_ENTITY_SECRET=""
# Optional pinned wallet set / wallet ids
CIRCLE_WALLET_SET_ID=""

# --- IPFS (Pinata) ----------------------------------------------------------
PINATA_JWT=""

# --- App (Next.js) ----------------------------------------------------------
NEXT_PUBLIC_ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.network"
NEXT_PUBLIC_ARC_TESTNET_EXPLORER="https://testnet.arcscan.app"
NEXT_PUBLIC_PRIVY_APP_ID=""

# --- x402 server ------------------------------------------------------------
MERCHANT_ADDRESS=""
X402_SERVER_PORT="4402"
